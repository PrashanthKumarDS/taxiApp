rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Allow authenticated drivers to read active rides
    match /rides/{rideId} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null;
      allow update, delete: if request.auth.uid == resource.data.userId || request.auth.uid == resource.data.driverId;
    }

    // Tour packages: readable by any signed-in user, managed via the
    // Firebase console (admin SDK bypasses these rules).
    match /tour_packages/{document=**} {
      allow read: if request.auth.uid != null;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
